	int "Peripheral supervision timeout (10ms units)"
	default 800
	range 10 3200

endif # BT_SUBRATING && ZMK_SPLIT && !ZMK_SPLIT_ROLE_CENTRAL

# ============================================================================
# ============================================================================
# BLE LLPM (Low Latency Packet Mode) for split link
# ============================================================================

menuconfig ZMK_BLE_SCI
	bool "BLE SCI (Shorter Connection Intervals) for split link"
	depends on ZMK_BT_LL_SOFTDEVICE
	depends on BT_CENTRAL
	select BT_CTLR_SDC_SHORTER_CONNECTION_INTERVALS
	select BT_CTLR_SDC_CONNECTION_RATE_UPDATE
	select BT_CTLR_FRAME_SPACE_UPDATE
	help
	  Use standard BLE 6.2 Shorter Connection Intervals to run the
	  split central-peripheral BLE link at sub-7.5ms connection
	  intervals (down to 750us on nRF52840 with 2M PHY).

	  Negotiated via standard LL_CONNECTION_RATE_REQUEST PDUs —
	  no vendor-specific LLPM handshake needed. Requires both sides
	  to run nrfxlib v3.4.0+ with SCI support enabled.

	  The host link (to macOS/Windows/Linux) is unaffected — SCI
	  only applies to connections where the local device is the
	  BLE central.

	  Trade-off: lower latency and less trailing float, but more
	  radio wakeups (higher power during active use).

if ZMK_BLE_SCI

config ZMK_BLE_SCI_INTERVAL_US
	int "SCI connection interval (microseconds)"
	default 2000
	range 750 7000
	help
	  Target connection interval for the split link in microseconds.
	  BLE 6.2 SCI uses 0.125ms (125us) units internally.
	  750  = 750us (lowest on nRF52840 with 2M PHY + lowest FSU)
	  1000 = 1ms
	  2000 = 2ms (good balance for trackpoint/mouse)
	  7000 = 7ms (close to standard BLE minimum)

config ZMK_BLE_SCI_SWITCH_DELAY_MS
	int "Delay before starting SCI procedures (ms)"
	default 500
	range 100 5000
	help
	  Milliseconds to wait after PHY 2M is established before
	  starting the SCI switch (Frame Space Update + Connection
	  Rate Request). Allows pairing/encryption to complete first.

config ZMK_BLE_SCI_PHY_SWITCH_DELAY_MS
	int "Delay for PHY-triggered SCI switch (ms)"
	default 2500
	range 1000 10000
	help
	  Milliseconds to wait after PHY 2M before starting SCI on a new
	  connection. Longer than SCI_SWITCH_DELAY_MS to give the peripheral
	  trackpoint init time to complete PS/2 initialization at standard
	  7.5ms CI before SCI drops CI to sub-7.5ms.

config ZMK_BLE_SCI_RETRIGGER_DELAY_MS
	int "Delay before re-triggering SCI after reconnection (ms)"
	default 50
	range 10 200
	help
	  Milliseconds to wait before re-triggering SCI after the split
	  peripheral reconnects with active parameters (CI <= 10ms,
	  latency=0). Shorter than the initial delay since the link is
	  already established. Only applies to reconnection scenarios
	  where SCI was previously active.

config ZMK_BLE_SCI_FLUSH_TIMEOUT_MIN_SLOTS
	int "Minimum flush timeout (baseband slots, 0.625ms each)"
	default 8
	range 0 255
	help
	  Minimum flush timeout for Flushable ACL Data. The actual
	  timeout scales with the connection interval to allow ~3
	  connection events for delivery:
	    flush_slots = max(this, CI_slots * 3)

	  8 slots = 5ms (good floor for sub-7.5ms CI).
	  Set to 0 to disable flush timeout entirely.

	  Requires CONFIG_BT_CTLR_LE_FLUSHABLE_ACL_DATA=y.

config ZMK_BLE_SCI_SUPERVISION_TIMEOUT
	int "SCI supervision timeout (×10ms)"
	default 600
	range 100 3200
	help
	  Supervision timeout for the SCI connection in 10ms units.
	  600 = 6 seconds. Range: 1-32 seconds.

	  With 2ms CI and subrating (idle factor=15, dormant factor=80),
	  a 4s timeout gives only ~25 missed dormant events before
	  disconnect. 6s survives longer Wi-Fi interference bursts
	  without triggering unnecessary split reconnections.

module = ZMK_BLE_SCI
module-str = zmk_ble_sci
source "subsys/logging/Kconfig.template.log_config"

endif # ZMK_BLE_SCI

# ============================================================================
# BLE QoS Channel Map Filter
# ============================================================================

menuconfig ZMK_BLE_QOS
	bool "BLE QoS channel map filter"
	depends on ZMK_BT_LL_SOFTDEVICE
	depends on BT_CENTRAL
	select BT_HCI_VS_EVT_USER
	select BT_CTLR_SDC_QOS_CONN_EVENT_REPORT
	help
	  Dynamically avoids congested BLE channels using per-connection CRC
	  error statistics from the SoftDevice Controller. Uses Nordic's
	  chmap_filter library to rate channels and update the channel map.

	  Only effective on connections where the local device is the BLE
	  central (i.e. the split keyboard link). The host link channel map
	  is controlled by the host.

if ZMK_BLE_QOS

config ZMK_BLE_QOS_INTERVAL
	int "QoS baseline processing interval (ms)"
	default 1000
	range 100 10000
	help
	  Baseline interval for the QoS thread. The thread decays back to
	  this interval when no CRC errors are detected. During interference
	  the interval drops to ZMK_BLE_QOS_INTERVAL_FAST and doubles each
	  clean cycle until reaching this value.

config ZMK_BLE_QOS_INTERVAL_FAST
	int "QoS fast processing interval on CRC errors (ms)"
	default 100
	range 50 1000
	help
	  When CRC errors are detected, the QoS processing interval drops
	  to this value for rapid channel map adaptation. The interval then
	  doubles each error-free cycle back toward QOS_INTERVAL.

config ZMK_BLE_QOS_STACK_SIZE
	int "QoS thread stack size"
	default 768
	help
	  Stack size for the QoS processing thread.

config ZMK_BLE_QOS_HOST_MAP_MERGE
	bool "Merge host-link channel map into split-link QoS"
	default y
	help
	  Read the host connection's channel map (controlled by macOS/Windows/
	  Linux) and AND it with the chmap_filter output before applying to
	  the split link. This lets the split link benefit from the host's
	  independent AFH observations without waiting to discover the same
	  interference via CRC errors.

	  Requires a host (peripheral-role) connection to be active. When no
	  host is connected the QoS filter operates standalone.

config ZMK_BLE_QOS_HOST_MAP_MIN_CHANNELS
	int "Minimum channels after host map merge"
	default 15
	depends on ZMK_BLE_QOS_HOST_MAP_MERGE
	range 2 37
	help
	  If ANDing the QoS filter output with the host channel map would
	  leave fewer than this many channels, skip the merge and use the
	  QoS-only map. Prevents over-restriction when both maps are
	  independently conservative.

config ZMK_BLE_QOS_MIN_CHANNEL_COUNT
	int "Minimum channels the chmap_filter will keep"
	default 15
	range 2 37
	help
	  Minimum number of BLE data channels that chmap_filter will keep in
	  the channel map. The library default (4) allows near-starvation under
	  WiFi coexistence. 15 maintains Channel Selection Algorithm #2 spacing
	  >= 3, providing adequate frequency diversity to tolerate residual
	  interference from colocated BLE devices and USB 3.0 noise.

config ZMK_BLE_QOS_EVAL_KEEPOUT_DURATION
	int "Blocked-channel keepout duration (filter process cycles)"
	default 2000
	range 100 10000
	help
	  Number of chmap_filter_process() cycles a blocked channel must wait
	  before being re-evaluated. At the 1s baseline interval this is
	  ~2000 seconds. WiFi APs sit on a fixed channel for hours/days, so
	  probing blocked WiFi channels every 5 minutes (300 cycles at 1s) is
	  wasteful and causes periodic packet loss spikes.

	  2000 cycles (~33 min at 1s baseline) matches WiFi persistence.
	  dynamic_durations scales this based on channel history — channels
	  that were blocked before get longer keepout automatically.

config ZMK_BLE_QOS_REINIT_ON_WAKE
	bool "Re-initialize channel map filter on wake from sleep"
	default y
	help
	  When the keyboard wakes from ZMK_ACTIVITY_SLEEP (after hours of
	  deep sleep), the RF environment has likely changed significantly:
	  the user may have moved to a different room, WiFi APs may have
	  changed channels, or new interference sources may be present.

	  Re-initializing the chmap_filter clears stale channel ratings and
	  blocked-channel history, giving the filter a fresh start with all
	  37 channels enabled. The tuned parameters (min_channel_count,
	  eval_keepout_duration) are re-applied after re-init.

config ZMK_BLE_QOS_CHANNEL_SURVEY
	bool "Channel survey energy-based blocking"
	select BT_CTLR_SDC_QOS_CHANNEL_SURVEY
	help
	  Enable SDC QoS Channel Survey as a supplemental blocking layer.
	  The survey measures RF energy on each BLE data channel and blocks
	  channels above an energy threshold, providing early warning of
	  WiFi or other 2.4 GHz interference before CRC errors accumulate.

	  Survey blocks use a short keepout (tens of seconds) so false
	  positives self-correct quickly. True positives are independently
	  confirmed and promoted to long-term blocks by the CRC-based
	  chmap_filter.

	  The survey runs at fourth scheduling priority in the SDC and may
	  produce sparse reports under heavy connection load. This is
	  handled gracefully — if no reports arrive, the survey layer has
	  no effect.

if ZMK_BLE_QOS_CHANNEL_SURVEY

config ZMK_BLE_QOS_SURVEY_INTERVAL_US
	int "Survey measurement target interval (microseconds)"
	default 4000000
	range 3000 4000000
	help
	  Target average interval between channel survey measurements.
	  The SDC will attempt to schedule measurements at this rate, but
	  due to fourth scheduling priority, actual intervals may be longer.

	  Valid range: 3,000 - 4,000,000 us (SDK constraint). Use 0 to
	  schedule at every available opportunity. 4,000,000 (4 seconds)
	  is the most power-efficient rate that stays within SDK limits.
	  Under dual 7.5ms connection interval load, reports may arrive
	  less frequently.

config ZMK_BLE_QOS_ADAPTIVE_ENERGY
	bool "Adaptive energy weight (LTE-U pattern)"
	default y
	depends on ZMK_BLE_QOS_CHANNEL_SURVEY
	help
	  Dynamically tune trust in the energy sensor based on correlation
	  with CRC error rates.  When energy detection accurately predicts
	  packet loss, its weight increases; when it produces false positives,
	  its weight decreases.  Wiener-optimal step sizing tied to the
	  adaptive interval for correct transient/persistent handling.
	  Channel-count-normalized CRC thresholds prevent channel starvation.

config ZMK_BLE_QOS_SCORE_W_ENERGY_MIN
	int "Minimum adaptive energy weight (Q8)"
	default 64
	range 0 512
	depends on ZMK_BLE_QOS_ADAPTIVE_ENERGY
	help
	  Floor for the adaptive energy weight.  64 = 0.25x.
	  Even unreliable energy data has some information content.

config ZMK_BLE_QOS_SCORE_W_ENERGY_MAX
	int "Maximum adaptive energy weight (Q8)"
	default 512
	range 256 2048
	depends on ZMK_BLE_QOS_ADAPTIVE_ENERGY
	help
	  Ceiling for the adaptive energy weight.  512 = 2.0x.
	  At maximum, energy alone can reach the block threshold,
	  enabling fully proactive channel blocking when calibrated.

endif # ZMK_BLE_QOS_CHANNEL_SURVEY

# Priority-score algorithm tuning
# Weights are Q8 fixed point: 256 = 1.0

config ZMK_BLE_QOS_SCORE_W_ENERGY
	int "Energy score weight / initial adaptive weight (Q8)"
	default 64
	range 0 2048
	help
	  Weight applied to energy-above-noise-floor in the priority score.
	  256 = 1.0x.  Must be >= W_ENERGY_MIN for adaptation invariant.
	  Default 64 (= W_ENERGY_MIN = 0.25x): starts at the floor so
	  convergence is immediate while preserving energy visibility.
	  When ZMK_BLE_QOS_ADAPTIVE_ENERGY is enabled, this is the initial
	  value; the weight adapts at runtime between W_ENERGY_MIN and
	  W_ENERGY_MAX based on CRC correlation.

config ZMK_BLE_QOS_SCORE_W_CRC
	int "CRC error score weight (Q8)"
	default 1024
	range 0 4096
	help
	  Weight applied to CRC error ratio in the priority score.
	  1024 = 4.0x.  CRC errors are definitive proof of packet loss.
	  This should be the highest weight to ensure channels with confirmed
	  errors are deprioritized decisively.

config ZMK_BLE_QOS_SCORE_W_HOST
	int "Host/dongle map penalty weight (Q8)"
	default 384
	range 0 2048
	help
	  Flat penalty added to channels blocked by the host/dongle's AFH.
	  384 = 1.5x.  This is a soft signal — the host/dongle has different
	  antenna position and may see different interference.  Not a veto.
	  For dongle mode: captures USB3 noise the keyboard may not detect.
	  For OS mode: captures WiFi coexistence data from macOS/Windows.

config ZMK_BLE_QOS_SCORE_W_FILTER
	int "chmap_filter penalty weight (Q8)"
	default 512
	range 0 2048
	help
	  Flat penalty added to channels blocked by Nordic's chmap_filter.
	  512 = 2.0x.  The filter detects WiFi-shaped interference patterns
	  (contiguous BLE channel blocks matching 802.11 channel widths).
	  Stronger than host penalty because it uses CRC-confirmed data with
	  WiFi pattern awareness.

config ZMK_BLE_QOS_SCORE_NOISE_FLOOR
	int "Energy noise floor (dBm)"
	default -90
	range -110 -60
	help
	  Energy readings below this value contribute zero to the score.
	  Set to the observed noise floor of the RF environment.  Typical
	  values: -90 dBm (quiet office), -85 dBm (busy apartment).
	  Only energy ABOVE this floor contributes to channel badness.

config ZMK_BLE_QOS_SCORE_BLOCK_THRESHOLD
	int "Score threshold for channel exclusion"
	default 512
	range 128 4096
	help
	  Channels with composite priority score above this threshold are
	  excluded from the channel map, provided at least MIN_CHANNEL_COUNT
	  channels remain included.

	  Lower values = more aggressive exclusion (fewer channels used).
	  Higher values = more permissive (keep channels with moderate scores).
	  512 is a reasonable starting point: requires multiple weak signals
	  or one strong CRC-confirmed bad channel to trigger exclusion.

module = ZMK_BLE_QOS
module-str = zmk_ble_qos
source "subsys/logging/Kconfig.template.log_config"

endif # ZMK_BLE_QOS

# ============================================================================
# LE Power Control Autonomous Mode
# ============================================================================

config ZMK_BLE_POWER_CONTROL_AUTO
	bool "Enable autonomous LE Power Control Request"
	depends on ZMK_BT_LL_SOFTDEVICE
	depends on BT_TRANSMIT_POWER_CONTROL
	help
	  Configure the SoftDevice Controller to autonomously send
	  LL_POWER_CONTROL_REQ when the average RSSI of a connection drifts
	  outside the configured golden range. Also enables responding to
	  power adjustment requests from the peer (APR handling).

	  This requires CONFIG_BT_TRANSMIT_POWER_CONTROL=y and
	  CONFIG_BT_CTLR_LE_POWER_CONTROL=y in the controller.

	  The VS HCI command sdc_hci_cmd_vs_set_power_control_request_params
	  is sent once after the first BLE connection is established.

if ZMK_BLE_POWER_CONTROL_AUTO

config ZMK_BLE_POWER_CONTROL_RSSI_LOWER_LIMIT
	int "RSSI lower limit of golden range (dBm)"
	default -70
	range -100 -20
	help
	  When average RSSI drops below this threshold, the controller
	  autonomously requests the peer to increase TX power.
	  -70 dBm is appropriate for keyboard-to-host at 1-3m range.

config ZMK_BLE_POWER_CONTROL_RSSI_UPPER_LIMIT
	int "RSSI upper limit of golden range (dBm)"
	default -30
	range -80 0
	help
	  When average RSSI rises above this threshold, the controller
	  autonomously requests the peer to decrease TX power.
	  -30 dBm is appropriate for very close range (split link).

config ZMK_BLE_POWER_CONTROL_RSSI_LOWER_TARGET
	int "Target RSSI when below lower limit (dBm)"
	default -65
	range -90 -20
	help
	  The controller requests peer TX power adjustment to reach this
	  RSSI when the average is below the lower limit.

config ZMK_BLE_POWER_CONTROL_RSSI_UPPER_TARGET
	int "Target RSSI when above upper limit (dBm)"
	default -35
	range -70 0
	help
	  The controller requests peer TX power adjustment to reach this
	  RSSI when the average is above the upper limit.

config ZMK_BLE_POWER_CONTROL_WAIT_PERIOD_MS
	int "Minimum interval between autonomous requests (ms)"
	default 5000
	range 1000 30000
	help
	  Minimum time in milliseconds between consecutive autonomous
	  LL_POWER_CONTROL_REQ procedures. Prevents rapid-fire requests
	  when RSSI is oscillating near a threshold.

config ZMK_BLE_POWER_CONTROL_BETA
	int "RSSI averaging weight (0-4095)"
	default 2048
	range 0 4095
	help
	  Exponential weighted moving average weight for RSSI calculation.
	  Higher values weight history more heavily (slower response).
	  avg[n] = (beta/4096) * avg[n-1] + (1 - beta/4096) * rssi[n]
	  2048 = gamma of 0.5, a balanced compromise between responsiveness
	  and stability.

config ZMK_BLE_POWER_CONTROL_APR_MARGIN
	int "APR margin (dB)"
	default 5
	range 0 20
	help
	  When the peer requests us to reduce TX power (via APR in
	  LL_POWER_CONTROL_RSP), the actual reduction applied is
	  (received_apr - apr_margin). This hysteresis prevents
	  ping-pong power oscillations. Default 5 dB.

endif # ZMK_BLE_POWER_CONTROL_AUTO

# ============================================================================
# LE Path Loss Monitoring
# ============================================================================

config ZMK_BLE_PATH_LOSS_MONITORING
	bool "Enable LE Path Loss Monitoring on host link"
	depends on ZMK_BT_LL_SOFTDEVICE
	depends on BT_PATH_LOSS_MONITORING
	depends on BT_PERIPHERAL
	help
	  Configure and enable LE Path Loss Monitoring on each host-link
	  connection (peripheral role). The controller reports zone transitions
	  when the estimated path loss crosses configured thresholds.

	  Path loss = peer_tx_power - local_rssi. Higher values indicate the
	  device is farther from the host or experiencing RF attenuation.

	  Requires the host (macOS/Windows/Linux) to support LE Power Control
	  (BLE 5.2+). If the peer doesn't support it, the controller reports
	  ZONE_UNAVAILABLE and the feature is silently inactive.

if ZMK_BLE_PATH_LOSS_MONITORING

config ZMK_BLE_PATH_LOSS_HIGH_THRESHOLD
	int "High path loss threshold (dB)"
	default 70
	range 20 255
	help
	  Path loss above this value triggers the HIGH zone event.
	  For a keyboard at 1-3m from a laptop, 70 dB indicates the signal
	  is getting weak (borderline for reliable BLE communication).
	  At this point the controller should consider boosting TX power.

config ZMK_BLE_PATH_LOSS_HIGH_HYSTERESIS
	int "High threshold hysteresis (dB)"
	default 6
	range 0 20
	help
	  Path loss must drop this many dB below the high threshold
	  before transitioning back to the MIDDLE zone. Prevents rapid
	  zone toggling when path loss oscillates near the threshold.

config ZMK_BLE_PATH_LOSS_LOW_THRESHOLD
	int "Low path loss threshold (dB)"
	default 40
	range 10 200
	help
	  Path loss below this value triggers the LOW zone event.
	  For a keyboard, 40 dB indicates very close range (< 0.5m)
	  where the split halves typically sit. TX power can be reduced.

config ZMK_BLE_PATH_LOSS_LOW_HYSTERESIS
	int "Low threshold hysteresis (dB)"
	default 6
	range 0 20
	help
	  Path loss must rise this many dB above the low threshold
	  before transitioning to the MIDDLE zone.

config ZMK_BLE_PATH_LOSS_MIN_TIME_SPENT
	int "Minimum time in new zone before reporting (conn events)"
	default 100
	range 1 65535
	help
	  Number of connection events the path loss must remain in the
	  new zone before the controller generates a threshold report.
	  Debounces transient signal fluctuations.

	  With 11.25ms host CI: 100 events = ~1.1 seconds.
	  With 7.5ms host CI: 100 events = ~0.75 seconds.

endif # ZMK_BLE_PATH_LOSS_MONITORING
