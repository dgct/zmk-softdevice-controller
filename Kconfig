rsource "src/sdc/Kconfig"

# Three-tier subrating: ACTIVE (typing) -> IDLE (~30s) -> DORMANT (+5min)
# Central controls tier transitions; peripheral requests ACTIVE on local activity

# ACTIVE tier params shared by both central and peripheral
if BT_SUBRATING && ZMK_SPLIT

config ZMK_BLE_SUBRATE_ACTIVE_MIN
	int "Active subrate factor minimum"
	default 1
	range 1 500

config ZMK_BLE_SUBRATE_ACTIVE_MAX
	int "Active subrate factor maximum"
	default 2
	range 1 500

config ZMK_BLE_SUBRATE_ACTIVE_CN
	int "Active continuation number"
	default 1
	range 0 499

endif # BT_SUBRATING && ZMK_SPLIT

if BT_SUBRATING && ZMK_SPLIT_ROLE_CENTRAL

config ZMK_BLE_SUBRATE_TIMEOUT
	int "Supervision timeout (10ms units)"
	default 800
	range 10 3200

config ZMK_BLE_SUBRATE_ACTIVE_MAX_LATENCY
	int "Active maximum peripheral latency"
	default 4
	range 0 499

# IDLE tier
config ZMK_BLE_SUBRATE_IDLE_MIN
	int "Idle subrate factor minimum"
	default 1
	range 1 500

config ZMK_BLE_SUBRATE_IDLE_MAX
	int "Idle subrate factor maximum"
	default 15
	range 1 500

config ZMK_BLE_SUBRATE_IDLE_CN
	int "Idle continuation number"
	default 14
	range 0 499

config ZMK_BLE_SUBRATE_IDLE_MAX_LATENCY
	int "Idle maximum peripheral latency"
	default 2
	range 0 499

# DORMANT tier
config ZMK_BLE_SUBRATE_DORMANT_DELAY
	int "Milliseconds before dormant tier"
	default 900000
	range 10000 3600000

config ZMK_BLE_SUBRATE_DORMANT_MIN
	int "Dormant subrate factor minimum"
	default 1
	range 1 500

config ZMK_BLE_SUBRATE_DORMANT_MAX
	int "Dormant subrate factor maximum"
	default 80
	range 1 500

config ZMK_BLE_SUBRATE_DORMANT_CN
	int "Dormant continuation number"
	default 20
	range 0 499

config ZMK_BLE_SUBRATE_DORMANT_MAX_LATENCY
	int "Dormant maximum peripheral latency"
	default 0
	range 0 499

# Host connection parameters for dormant tier
# When entering dormant, request slower connection interval from hosts to save power

config ZMK_BLE_HOST_CONN_PARAM_DORMANT
	bool "Update host connection parameters when dormant"
	default n
	help
	  When entering dormant tier, request slower connection parameters from
	  host devices to reduce power consumption. Parameters are restored when
	  returning to active state.

if ZMK_BLE_HOST_CONN_PARAM_DORMANT

config ZMK_BLE_HOST_CONN_DORMANT_INT_MIN
	int "Host dormant connection interval minimum (1.25ms units)"
	default 36
	range 6 3200
	help
	  Minimum connection interval when dormant. 36 = 45ms.
	  Must be a multiple of 12 (15ms) per Apple guidelines.

config ZMK_BLE_HOST_CONN_DORMANT_INT_MAX
	int "Host dormant connection interval maximum (1.25ms units)"
	default 36
	range 6 3200
	help
	  Maximum connection interval when dormant. 36 = 45ms.
	  Must be at least 12 (15ms) greater than min, or equal to min.

config ZMK_BLE_HOST_CONN_DORMANT_LATENCY
	int "Host dormant peripheral latency"
	default 30
	range 0 30
	help
	  Number of connection events the peripheral can skip when dormant.
	  Higher values save more power but increase response latency.
	  Apple guidelines: max 30, and interval_max * (latency + 1) <= 6000ms.

config ZMK_BLE_HOST_CONN_DORMANT_TIMEOUT
	int "Host dormant supervision timeout (10ms units)"
	default 600
	range 10 3200
	help
	  Supervision timeout when dormant. 600 = 6000ms.
	  Must be > interval_max * (latency + 1) * 3.

endif # ZMK_BLE_HOST_CONN_PARAM_DORMANT

endif # BT_SUBRATING && ZMK_SPLIT_ROLE_CENTRAL

if BT_SUBRATING && ZMK_SPLIT && !ZMK_SPLIT_ROLE_CENTRAL

config ZMK_BLE_SUBRATE_PERIPHERAL_TIMEOUT
	int "Peripheral supervision timeout (10ms units)"
	default 800
	range 10 3200

endif # BT_SUBRATING && ZMK_SPLIT && !ZMK_SPLIT_ROLE_CENTRAL

# ============================================================================
# ============================================================================
# BLE LLPM (Low Latency Packet Mode) for split link
# ============================================================================

menuconfig ZMK_BLE_LLPM
	bool "BLE LLPM for split link"
	depends on ZMK_BT_LL_SOFTDEVICE
	depends on BT_CENTRAL
	select BT_CTLR_SDC_LLPM
	help
	  Use Nordic's Low Latency Packet Mode to run the split
	  central-peripheral BLE link at 1-7ms connection intervals
	  (in 1ms steps) instead of the BLE-standard 7.5ms minimum.

	  Both halves must run the SoftDevice Controller. The host link
	  (to macOS/Windows/Linux) is unaffected — LLPM only applies to
	  connections where the local device is the BLE central.

	  Trade-off: lower latency and less trailing float, but more
	  radio wakeups (higher power during active use).

if ZMK_BLE_LLPM

config ZMK_BLE_LLPM_INTERVAL_US
	int "LLPM connection interval (microseconds)"
	default 2000
	range 1000 7000
	help
	  Target connection interval for the split link in microseconds.
	  Valid range: 1000-7000 in 1000 us steps.
	  1000 = 1ms (lowest latency, highest power)
	  2000 = 2ms (good balance for trackpoint/mouse)
	  7000 = 7ms (close to standard BLE minimum)

config ZMK_BLE_LLPM_SWITCH_DELAY_MS
	int "Delay before switching to LLPM (ms)"
	default 500
	range 100 5000
	help
	  Milliseconds to wait after connection before issuing the
	  vendor-specific connection update to switch to LLPM interval.
	  Allows pairing/encryption to complete first.

config ZMK_BLE_LLPM_SUPERVISION_TIMEOUT
	int "LLPM supervision timeout (×10ms)"
	default 400
	range 100 3200
	help
	  Supervision timeout for the LLPM connection in 10ms units.
	  400 = 4 seconds. Range: 1-32 seconds.

module = ZMK_BLE_LLPM
module-str = zmk_ble_llpm
source "subsys/logging/Kconfig.template.log_config"

endif # ZMK_BLE_LLPM

# ============================================================================
# BLE QoS Channel Map Filter
# ============================================================================

menuconfig ZMK_BLE_QOS
	bool "BLE QoS channel map filter"
	depends on ZMK_BT_LL_SOFTDEVICE
	depends on BT_CENTRAL
	select BT_HCI_VS_EVT_USER
	select BT_CTLR_SDC_QOS_CONN_EVENT_REPORT
	help
	  Dynamically avoids congested BLE channels using per-connection CRC
	  error statistics from the SoftDevice Controller. Uses Nordic's
	  chmap_filter library to rate channels and update the channel map.

	  Only effective on connections where the local device is the BLE
	  central (i.e. the split keyboard link). The host link channel map
	  is controlled by the host.

if ZMK_BLE_QOS

config ZMK_BLE_QOS_INTERVAL
	int "QoS baseline processing interval (ms)"
	default 1000
	range 100 10000
	help
	  Baseline interval for the QoS thread. The thread decays back to
	  this interval when no CRC errors are detected. During interference
	  the interval drops to ZMK_BLE_QOS_INTERVAL_FAST and doubles each
	  clean cycle until reaching this value.

config ZMK_BLE_QOS_INTERVAL_FAST
	int "QoS fast processing interval on CRC errors (ms)"
	default 100
	range 50 1000
	help
	  When CRC errors are detected, the QoS processing interval drops
	  to this value for rapid channel map adaptation. The interval then
	  doubles each error-free cycle back toward QOS_INTERVAL.

config ZMK_BLE_QOS_STACK_SIZE
	int "QoS thread stack size"
	default 768
	help
	  Stack size for the QoS processing thread.

config ZMK_BLE_QOS_HOST_MAP_MERGE
	bool "Merge host-link channel map into split-link QoS"
	default y
	help
	  Read the host connection's channel map (controlled by macOS/Windows/
	  Linux) and AND it with the chmap_filter output before applying to
	  the split link. This lets the split link benefit from the host's
	  independent AFH observations without waiting to discover the same
	  interference via CRC errors.

	  Requires a host (peripheral-role) connection to be active. When no
	  host is connected the QoS filter operates standalone.

config ZMK_BLE_QOS_HOST_MAP_MIN_CHANNELS
	int "Minimum channels after host map merge"
	default 15
	depends on ZMK_BLE_QOS_HOST_MAP_MERGE
	range 2 37
	help
	  If ANDing the QoS filter output with the host channel map would
	  leave fewer than this many channels, skip the merge and use the
	  QoS-only map. Prevents over-restriction when both maps are
	  independently conservative.

config ZMK_BLE_QOS_MIN_CHANNEL_COUNT
	int "Minimum channels the chmap_filter will keep"
	default 15
	range 2 37
	help
	  Minimum number of BLE data channels that chmap_filter will keep in
	  the channel map. The library default (4) allows near-starvation under
	  WiFi coexistence. 15 maintains Channel Selection Algorithm #2 spacing
	  >= 3, providing adequate frequency diversity to tolerate residual
	  interference from colocated BLE devices and USB 3.0 noise.

config ZMK_BLE_QOS_EVAL_KEEPOUT_DURATION
	int "Blocked-channel keepout duration (filter process cycles)"
	default 2000
	range 100 10000
	help
	  Number of chmap_filter_process() cycles a blocked channel must wait
	  before being re-evaluated. At the 1s baseline interval this is
	  ~2000 seconds. WiFi APs sit on a fixed channel for hours/days, so
	  probing blocked WiFi channels every 5 minutes (300 cycles at 1s) is
	  wasteful and causes periodic packet loss spikes.

	  2000 cycles (~33 min at 1s baseline) matches WiFi persistence.
	  dynamic_durations scales this based on channel history — channels
	  that were blocked before get longer keepout automatically.

config ZMK_BLE_QOS_REINIT_ON_WAKE
	bool "Re-initialize channel map filter on wake from sleep"
	default y
	help
	  When the keyboard wakes from ZMK_ACTIVITY_SLEEP (after hours of
	  deep sleep), the RF environment has likely changed significantly:
	  the user may have moved to a different room, WiFi APs may have
	  changed channels, or new interference sources may be present.

	  Re-initializing the chmap_filter clears stale channel ratings and
	  blocked-channel history, giving the filter a fresh start with all
	  37 channels enabled. The tuned parameters (min_channel_count,
	  eval_keepout_duration) are re-applied after re-init.

module = ZMK_BLE_QOS
module-str = zmk_ble_qos
source "subsys/logging/Kconfig.template.log_config"

endif # ZMK_BLE_QOS
